<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <!--xs:import namespace="http://www.w3.org/2001/XMLSchema-instance" schemaLocation="xsi.xsd"/-->
	<!-- Schema einer Indexdatei -->	
	<xs:element name="LuksISSIndex">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Ersteller" type="xs:normalizedString"/>
				<xs:element name="Erstellzeitpunkt" type="xs:normalizedString"/>
				<xs:element name="Kommentar" type="xs:string"/>
				<xs:element name="WerkzeugName" type="xs:normalizedString"/>
				<xs:element name="WerkzeugVersion" type="xs:token"/>
				<xs:element name="SchnittstelleVersion" type="xs:token" fixed="3.3.1"/>
				<xs:element name="StammdatenVersion" type="DatenVersion"/>
				<xs:element name="OrdnungsrahmenVersion" type="DatenVersion"/>
				<xs:element name="SpurplandatenVersion" type="DatenVersion"/>
				<xs:element name="Dateien">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="Datei">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Name" type="xs:normalizedString"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<!--xs:attribute ref="xsi:noNamespaceSchemaLocation" use="required"/-->
		</xs:complexType>
	</xs:element>

	<xs:complexType name="DatenVersion">
		<xs:sequence>
			<xs:element ref="Name"/>
			<xs:element name="Nummer" type="xs:token"/>
			<xs:element name="GueltigAb" type="xs:token"/>
			<xs:element name="GueltigBis" type="xs:token"/>
			<xs:element ref="Beschreibung"/>
			<xs:element ref="LetzteAenderung"/>
		</xs:sequence>
	</xs:complexType>
	<!-- Ende Schema einer Indexdatei -->	


  
	<!-- Schema einer Datendatei -->		
	<xs:element name="LuksISSDaten">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Ersteller" type="xs:normalizedString"/>
				<xs:element name="Erstellzeitpunkt" type="xs:normalizedString"/>
				<xs:element name="Indexdatei" type="xs:normalizedString"/>
    			<xs:element name="Version">
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="Name"/>
							<xs:element name="Nummer" type="xs:token"/>
							<xs:element name="GueltigAb" type="xs:token"/>
							<xs:element name="GueltigBis" type="xs:token"/>
							<xs:element ref="Beschreibung"/>
							<xs:element ref="LetzteAenderung"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element minOccurs="0" ref="Stammdaten"/>
				<xs:element minOccurs="0" ref="Ordnungsrahmen"/>
				<xs:element minOccurs="0" ref="Spurplanbetriebsstellen"/>
				<xs:element minOccurs="0" ref="LDDefinitionen"/>
				<xs:element minOccurs="0" ref="InfrastrukturBereiche"/>
			</xs:sequence>
			<!--xs:attribute ref="xsi:noNamespaceSchemaLocation" use="required"/-->
		</xs:complexType>
	</xs:element>		
		
	<!-- Definitionen einiger mehrfach verwendeter Datentypen/Felder-->
	<xs:element name="Name" type="xs:normalizedString"/>
	<xs:element name="Beschreibung" type="xs:string"/>
	<xs:element name="LetzteAenderung" type="xs:token"/>
	<xs:simpleType name="JaNein">
		<xs:restriction base="xs:string">
			<xs:enumeration value="Ja"/>
			<xs:enumeration value="Nein"/>
		</xs:restriction>
	</xs:simpleType>
	<!-- Ende Definition der Datentypen -->
	
	<!-- Definition der linienförmigen Darstellung -->
	<xs:element name="LDDefinitionen">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="unbounded" name="LDDefinition">
						<xs:complexType>
							<xs:sequence>
								<xs:element ref="ID"/>
								<xs:element ref="Name"/>
								<xs:element name="Beschreibung" type="xs:string"/>
								<xs:element name="Zugklasse" type="xs:normalizedString"/>
								<xs:element name="Masstab" type="xs:integer"/>
								<xs:element name="Masstabfaktor" type="xs:integer"/>
								<xs:element name="LDLaufwege">
									<xs:complexType>
										<xs:sequence>
											<xs:element minOccurs="0" maxOccurs="unbounded" name="LDLaufweg">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="IDX" type="xs:integer"/>
														<xs:element name="Beachten" type="xs:integer"/>
														<xs:element name="Betriebsstelle" type="xs:normalizedString"/>
														<xs:element minOccurs="0" name="Fahrweg" type="xs:string"/>
													</xs:sequence>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="InfrastrukturBereiche">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" maxOccurs="unbounded" name="InfrastrukturBereich">
						<xs:complexType>
							<xs:sequence>
								<xs:element ref="ID"/>
								<xs:element ref="Name"/>
								<xs:element name="FesterSchluesselWertTyp" type="xs:string" minOccurs="0" />
								<xs:element minOccurs="0" name="UnterBereiche">
                                    <xs:complexType>
                                        <xs:sequence>
                                            <xs:choice minOccurs="0" maxOccurs="unbounded">
                                                <xs:element name="UnterBereich" type="UnterBereichAllgemein"/>
                                                <xs:element name="UnterBereichStreckenKM" type="UnterBereichStreckenKM"/>
                                            </xs:choice>
                                        </xs:sequence>
                                    </xs:complexType>
								</xs:element>
								<xs:element name="Typ" type="xs:integer" />
								<xs:element name="MehrereUnterbereicheProElementErlaubt" type="xs:boolean" />
							</xs:sequence>
						</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="Eisenbahnunternehmen">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Nr">
					<xs:simpleType>
						<xs:restriction base="GanzeZahl">
							<!-- "-1" für Dummy values -->
							<xs:minInclusive value="-1"/>
							<xs:maxInclusive value="9999"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Kurzname" type="Name"/>
				<xs:element name="Langname" type="Name"/>
				<xs:element name="NeUICKennzeichen" type="NeUIC"/>
				<xs:element ref="LetzteAenderung"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:complexType name="RefEU">
		<xs:simpleContent>
			<xs:extension base="Name">
				<xs:attribute name="Typ" type="NeUIC" use="required"/>
				<xs:attribute name="Nr" use="required">
					<xs:simpleType>
						<xs:restriction base="GanzeZahl">
							<!-- "-1" für Dummy values -->
							<xs:minInclusive value="-1"/>
							<xs:maxInclusive value="9999"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	
	<xs:complexType name="RefEU_Laendercode">
		<xs:simpleContent>
			<xs:extension base="Name">
				<xs:attribute name="Typ" type="LcNeUIC" use="required"/>
				<xs:attribute name="Nr" use="required">
					<xs:simpleType>
						<xs:restriction base="GanzeZahl">
							<!-- "-1" für Dummy values -->
							<xs:minInclusive value="-1"/>
							<xs:maxInclusive value="9999"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:attribute>
			</xs:extension>
		</xs:simpleContent>
	</xs:complexType>
	
	<xs:simpleType name="NeUIC">
		<xs:annotation>
			<xs:documentation>Werte: U, N</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:whiteSpace value="collapse" fixed="true"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="U"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="LcNeUIC">
		<xs:annotation>
			<xs:documentation>Werte: L, N, U</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:token">
			<xs:whiteSpace value="collapse" fixed="true"/>
			<xs:enumeration value="L"/>
			<xs:enumeration value="N"/>
			<xs:enumeration value="U"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="GanzeZahl">
		<xs:annotation>
			<xs:documentation>Format: 123</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:int">
			<xs:whiteSpace value="collapse" fixed="true"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:simpleType name="Name">
		<xs:annotation>
			<xs:documentation>String mit Leerzeichen</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve" fixed="true"/>
		</xs:restriction>
	</xs:simpleType>
	
	<xs:element name="Geschwindigkeitsband">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="IstStandardband" type="xs:boolean"/>
				<xs:element name="Name" type="xs:token"/>
				<xs:element name="DefaultGeschwindigkeit" type="xs:integer"/>
				<xs:element name="Wirkung" type="xs:integer"/>
				<xs:element name="ETCSTrainCategory" minOccurs="0" type="xs:integer"/>
				<xs:element name="Farbe" minOccurs="0" type="xs:token"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<!-- Definitionen des Ordnungsrahmens -->
	<xs:element name="Ordnungsrahmen">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="Betriebsstellen">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="Betriebsstelle">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="DS100" type="xs:normalizedString"/>
										<xs:element ref="Name"/>
										<xs:element name="Kurzname" type="xs:normalizedString"/>
										<xs:element name="Langname" type="xs:normalizedString" minOccurs="0"/>
										<xs:element minOccurs="0" name="Anzeigekategorie" type="xs:token"/>
										<xs:element name="Position">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="X" type="xs:token"/>
													<xs:element name="Y" type="xs:token"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Eisenbahnunternehmen" type="RefEU"/>
										<xs:element name="EisenbahnunternehmenGrenze1" type="RefEU" minOccurs="0"/>
										<xs:element name="EisenbahnunternehmenGrenze2" type="RefEU" minOccurs="0"/>
										<xs:element name="LUKS_Art" type="xs:integer"/>
										<xs:element name="ZustOrgeinheit" type="RefOE" />
										<xs:element ref="LetzteAenderung"/>
										<xs:element name="GFD_DB_ID" type="xs:integer"/>	
										<xs:element name="Planungshorizont" type="xs:token"/>
										<xs:element name="Attribute">
											<xs:complexType>
												<xs:sequence>
													<xs:element minOccurs="0" name="EinfahrtHalt"/>
													<xs:element minOccurs="0" name="KLDurchsatz"/>
													<xs:element minOccurs="0" name="Schreibschutz"/>
													<xs:element minOccurs="0" name="BetriebshalteZulassen"/>
													<xs:element minOccurs="0" name="KeinWegsetzen"/>
													<xs:element minOccurs="0" name="KeineGleisaenderung"/>
													<xs:element minOccurs="0" name="NichtErweitern"/>
													<xs:element minOccurs="0" name="OhneBiegen"/>
													<xs:element minOccurs="0" name="KreuzungNebengleis"/>
													<xs:element minOccurs="0" name="LWMalusNutzung"/>
													<xs:element minOccurs="0" name="LWMalus" type="xs:integer"/>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element name="Fixiert">
											<xs:complexType mixed="true">
												<xs:attribute name="Rz" use="required" type="xs:token"/>
												<xs:attribute name="Gz" use="required" type="xs:token"/>
												<xs:attribute name="Lz" use="required" type="xs:token"/>
											</xs:complexType>
										</xs:element>
										<xs:element name="Kommentar" type="xs:token"/>
										<xs:element ref="OptDis" />
										<xs:element name="Bundesland" type="RefSchluesselwert" minOccurs="0"/>
										<xs:element name="BundeslandGrenze1" type="RefSchluesselwert" minOccurs="0"/>
										<xs:element name="BundeslandGrenze2" type="RefSchluesselwert" minOccurs="0"/>
										<xs:element name="ArtXMLISS" type="RefSchluesselwert" minOccurs="0" />
										<xs:element name="Laendercode" type="RefSchluesselwert" minOccurs="0" />
										<xs:element name="BahnstellenNr" type="GanzeZahl" minOccurs="0"/>
										<xs:element name="PrimaryCode" minOccurs="0">
											<xs:simpleType>
												<xs:restriction base="GanzeZahl">
													<xs:minInclusive value="0"/>
													<xs:maxInclusive value="99999"/>
												</xs:restriction>
											</xs:simpleType>
										</xs:element>
										<xs:element name="NachbarOrgeinheit" type="RefOE" minOccurs="0"/>
										<xs:element name="Grenze1Orgeinheit" type="RefOE" minOccurs="0"/>
										<xs:element name="Grenze2Orgeinheit" type="RefOE" minOccurs="0"/>
										<xs:element name="Betriebsstandort" type="RefOE" minOccurs="0"/>
										<xs:element name="MutterBtrst" type="xs:string" minOccurs="0"/>
										<xs:element name="ZubWechselstelle" type="Wahrheit" minOccurs="0"/>
										<xs:element name="Traktionswechsel" type="Wahrheit" minOccurs="0"/>
										<xs:element name="Lokpersonalwechsel" type="Wahrheit" minOccurs="0"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element minOccurs="0" name="Strecken">
					<xs:complexType>
						<xs:sequence>
							<xs:element maxOccurs="unbounded" name="Strecke">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Nr" type="xs:normalizedString"/>
										<xs:element name="Kurzname" type="xs:normalizedString"/>
										<xs:element ref="Name"/>
										<xs:element ref="LetzteAenderung"/>
										<xs:element minOccurs="0" name="BetriebsstellenAnStrecke">
											<xs:complexType>
												<xs:sequence>
													<xs:element maxOccurs="unbounded" name="BetriebsstellenZuordnung">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="Betriebsstelle" type="xs:token"/>
																<xs:element name="BetriebsstellenlageRechts" type="xs:token"/>
																<xs:element ref="LetzteAenderung"/>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
										<xs:element minOccurs="0" name="Streckenabschnitte">
											<xs:complexType>
												<xs:sequence>
													<xs:element maxOccurs="unbounded" name="Streckenabschnitt">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="BetrName" type="Text" minOccurs="0"/>
																<xs:element name="BetrKurzname" type="Text" minOccurs="0"/>
																<xs:element name="Name11" type="Text" minOccurs="0"/>
																<xs:element name="KilometrierungVon" type="Kilometrierung"/>
																<xs:element name="KilometrierungBis" type="Kilometrierung"/>
																<xs:element name="AnfangsBetriebsstelle" type="xs:normalizedString"/>
																<xs:element name="EndeBetriebsstelle" minOccurs="0">
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="DS100" type="xs:normalizedString"/>
																			<xs:element name="ZusaetzlicheZugmeldestelle" type="Wahrheit" minOccurs="0"/>
																			<xs:element name="FplBearbeitungsgrenze" type="RefSchluesselwert" minOccurs="0"/>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
																<xs:element name="Eisenbahnunternehmen" type="RefEU" minOccurs="0"/>
																<xs:element name="Druckertuechtigung" type="Wahrheit" minOccurs="0"/>
																<xs:element name="Notbremsueberbrueckung" type="Wahrheit" minOccurs="0"/>
																<xs:element name="Lauffaehigkeit" type="Geschw" minOccurs="0"/>
																<xs:element name="Infrastrukturbearbeitungsbereich" type="RefOE" minOccurs="0"/>
																<xs:element name="Fahrplanbearbeitungsbereich" type="RefOE" minOccurs="0"/>
																<xs:element name="Art" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Bahnart" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Bahnnutzung" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Betriebsart" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Betreiberart" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Betriebsweise" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Spurweite" type="xs:token"/>
																<xs:element name="Streckenklassifizierung" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Streckenkategorie" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Streckenqualitaet" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Zugleitstelle" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="Zugleitbetrieb" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="ZugleitBtrst" type="xs:normalizedString" minOccurs="0"/>
																<xs:element name="Zugfunk" type="RefSchluesselwert" minOccurs="0"/>
																<xs:element name="KanalNr" minOccurs="0">
																	<xs:simpleType>
																		<xs:restriction base="GanzeZahl">
																			<xs:minInclusive value="0"/>
																			<xs:maxInclusive value="999"/>
																		</xs:restriction>
																	</xs:simpleType>
																</xs:element>
																<xs:element name="Zugschiebefunk" type="Wahrheit" minOccurs="0"/>
																<xs:element name="Gleisigkeit" type="GanzeZahl" minOccurs="0"/>
																<xs:element name="EU-Korridore" minOccurs="0">
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="PaP" type="RefSchluesselwert" minOccurs="0" maxOccurs="unbounded"/>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
																<xs:element name="Vorraenge" minOccurs="0">
																	<xs:complexType>
																		<xs:sequence>
																			<xs:element name="Vorrang" maxOccurs="unbounded">
																				<xs:complexType>
																					<xs:sequence>
																						<xs:element name="ZugartFV" type="RefZugartFV"/>
																						<xs:element name="Anfangszeit" type="Uhrzeit"/>
																						<xs:element name="Endzeit" type="Uhrzeit"/>
																					</xs:sequence>
																				</xs:complexType>
																			</xs:element>
																		</xs:sequence>
																	</xs:complexType>
																</xs:element>
																<xs:element name="LetzteAenderung" type="Zeitstempel"/>
															</xs:sequence>
														</xs:complexType>
													</xs:element>
												</xs:sequence>
											</xs:complexType>
										</xs:element>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>	
	<!-- Ende Definition des Ordnungsrahmens -->
	
	<!-- Definitionen der Stammdaten -->
	<xs:element name="Stammdaten">
		<xs:complexType>
			<xs:sequence>
				<xs:element minOccurs="0" name="Bremsarten">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" maxOccurs="unbounded" name="Bremsart">
								<xs:complexType>
									<xs:sequence minOccurs="0">
										<xs:element name="BremsartKennzeichen">
											<xs:complexType mixed="true">
												<xs:attribute name="Schluessel" use="required" type="xs:token"/>
												<xs:attribute name="Typ" use="required" type="xs:token" fixed="BREMSART-KENNZEICHEN"/>
											</xs:complexType>
										</xs:element>
										<xs:element name="BremsstellungZug">
											<xs:complexType mixed="true">
												<xs:attribute name="Schluessel" use="required" type="xs:token"/>
												<xs:attribute name="Typ" use="required" type="xs:token" fixed="BREMSSTELLUNG-ZUG"/>
											</xs:complexType>
										</xs:element>
										<xs:element name="Bremsstellungbezeichnung" type="xs:token"/>
										<xs:element ref="LetzteAenderung"/>
									</xs:sequence>
								</xs:complexType>
							</xs:element>	
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element minOccurs="0" name="Bremstafelkerne">
					<xs:complexType>
						<xs:sequence>
							<xs:element minOccurs="0" maxOccurs="unbounded" name="Bremstafelkern">
								<xs:complexType>
									<xs:sequence>
										<xs:element ref="Geschwindigkeit"/>
										<xs:element ref="Bremsart"/>
										<xs:element ref="Bremswegart"/>
										<xs:element ref="LetzteAenderung"/>
										<xs:element name="Bremstafeln">
											<xs:complexType>
												<xs:sequence>
													<xs:element maxOccurs="unbounded" name="Bremstafel">
														<xs:complexType>
															<xs:sequence>
																<xs:element name="Neigung" type="xs:token"/>
